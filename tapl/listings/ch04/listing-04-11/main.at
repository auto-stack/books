// Auto — Matrix Addition
fn main() {
    let a = [[1, 2], [3, 4]]
    let b = [[5, 6], [7, 8]]
    var c = [[0, 0], [0, 0]]

    for i in 0..2 {
        for j in 0..2 {
            c[i][j] = a[i][j] + b[i][j]
        }
    }

    println("Result matrix:")
    for i in 0..2 {
        println(f"  {c[i][0]} {c[i][1]}")
    }
}
